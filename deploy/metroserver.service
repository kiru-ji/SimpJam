[Unit]
Description=Metroserver (Listen Together sync relay) for SimpJam
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/metroserver/metroserver
Environment=PORT=8790
Environment=UA_POLICY_FILE=/opt/metroserver/ua_policy.json
Environment=DATABASE_FILE=/var/lib/metroserver/state.db
WorkingDirectory=/opt/metroserver
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/metroserver
ProtectHome=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
